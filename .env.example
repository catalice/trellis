TELEGRAM_BOT_TOKEN=
# Your numeric Telegram id. Empty admits NOBODY — send the bot /start to learn your id.
TELEGRAM_ALLOWED_USERS=
ANTHROPIC_API_KEY=
# Which provider answers (only 'anthropic' has a connector today) and the small
# model used for background summaries. Both optional.
# TRELLIS_MODEL_PROVIDER=anthropic
# TRELLIS_SMALL_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MODEL=claude-sonnet-5
# Required. Choose before the first `docker compose up` — Postgres fixes it when the
# volume is created. Any characters are fine. Scripts run on this machine use it too.
POSTGRES_PASSWORD=
OBSIDIAN_VAULT=./vault
TRELLIS_TIMEZONE=UTC
HEALTH_WORKER_URL=http://health-worker:8001
HEALTH_WORKER_SECRET=
TRELLIS_SECRET_KEY=

# Web search (Tavily) — free tier ~1000 searches/month. Optional; web_search tool
# only appears when set. Get a key at https://tavily.com
TAVILY_API_KEY=
GUARDIAN_API_KEY=
TRELLIS_CHAT_TTL_HOURS=0
TRELLIS_MORNING_MARKER_HOUR=-1
