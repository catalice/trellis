TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
DATABASE_URL=postgresql://trellis:trellis@localhost:5433/trellis
OBSIDIAN_VAULT=./vault
TRELLIS_TIMEZONE=UTC
HEALTH_WORKER_URL=http://health-worker:8001
HEALTH_WORKER_SECRET=
TRELLIS_SECRET_KEY=

# Web search (Tavily) — free tier ~1000 searches/month. Optional; web_search tool
# only appears when set. Get a key at https://tavily.com
TAVILY_API_KEY=
GUARDIAN_API_KEY=
TRELLIS_CHAT_TTL_HOURS=0
TRELLIS_MORNING_MARKER_HOUR=-1

# GitHub Models — embeddings for semantic search (text-embedding-3-small, 1536d).
# A GitHub personal access token with Models access; free tier is rate-limited.
# Create one at https://github.com/settings/tokens
GITHUB_TOKEN=
